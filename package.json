{
  "name": "lagos-life-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Lagos Life Virtual Currency Purchasing Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:admin": "npm run build --workspace=apps/admin",
    "build:api": "npm run build --workspace=apps/api",
    "start": "node apps/api/dist/main",
    "start:prod": "node apps/api/dist/main",
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "postinstall": "npm run prisma:generate"
  },
  "keywords": [
    "lagos-life",
    "currency",
    "in-game",
    "fintech"
  ],
  "author": "Lagos Life Virtual Hub",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/cli": "^11.0.1",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "isomorphic-git": "^1.44.19"
  }
}
